<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kajizmo Revit - Poteaux depuis DWG - v1.0.0"
        Width="480"
        Height="760"
        MinWidth="460"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#E9EDF0"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Palette de Couleurs -->
        <SolidColorBrush x:Key="Navy" Color="#17365D"/>
        <SolidColorBrush x:Key="NavyHover" Color="#24508A"/>
        <SolidColorBrush x:Key="NavyPressed" Color="#0F2A4A"/>
        <SolidColorBrush x:Key="Ink" Color="#1B2A3A"/>
        <SolidColorBrush x:Key="Muted" Color="#5E6B78"/>
        <SolidColorBrush x:Key="Tile" Color="#DAE3EB"/>
        <SolidColorBrush x:Key="Line" Color="#D3D9DF"/>
        <SolidColorBrush x:Key="HoverFill" Color="#E6ECF1"/>
        <SolidColorBrush x:Key="Vermillon" Color="#C9372C"/>

        <!-- Icônes (traits 24x24) -->
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Navy}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="6">
                <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Navy}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.15" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="0,6,0,3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M3,8 L7,12 L14,4" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Margin="3" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Navy}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Navy}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boutons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Navy}" CornerRadius="6" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1.5" CornerRadius="6" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cartes & Blocs -->
        <Style x:Key="SubCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <Grid Grid.Row="0" Height="40">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DCE7EF" Offset="0"/>
                    <GradientStop Color="#F1F3F1" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#4F6D8C" CornerRadius="5" Padding="10,3">
                <TextBlock x:Name="lbl_view_badge" Text="Vue active : Non détectée" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
            </Border>
        </Grid>

        <!-- CONTENU PRINCIPAL -->
        <Border Grid.Row="1" Background="#F1F3F1">
            <Border Margin="14,4,14,10" Padding="12" CornerRadius="10" Background="#EBFFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 1. DWG + 2. famille -->
                        <RowDefinition Height="Auto"/>   <!-- titre section 3 -->
                        <RowDefinition Height="*"/>      <!-- liste des dimensions (prend la place restante) -->
                        <RowDefinition Height="Auto"/>   <!-- 4. aperçu + statut -->
                    </Grid.RowDefinitions>

                    <!-- 1. FICHIER DWG (analyse automatique au changement de DWG) -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="1. FICHIER DWG" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SubCard}">
                            <StackPanel>
                                <TextBlock Text="DWG" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cb_dwg"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. FAMILLE DE POTEAU (vérifiée dès le choix) -->
                        <TextBlock Text="2. FAMILLE DE POTEAU" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource SubCard}">
                            <StackPanel>
                                <TextBlock Text="Famille (un type sera créé par dimension)" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cb_famille"/>
                                <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <TextBlock x:Name="txt_famille" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Margin="2,0,4,0" Text="Choisissez une famille de poteau."/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. DIMENSIONS DÉTECTÉES & TYPES -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="3. DIMENSIONS DÉTECTÉES &amp; TYPES"
                                   Style="{StaticResource SectionHeader}" Margin="2,0,8,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btn_select_all" Style="{StaticResource GhostButton}"
                                    Height="24" FontSize="11" Margin="0,0,6,0">
                                <TextBlock Text="Tout cocher"/>
                            </Button>
                            <Button x:Name="btn_select_none" Style="{StaticResource GhostButton}"
                                    Height="24" FontSize="11">
                                <TextBlock Text="Tout décocher"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource SubCard}" Padding="8,8,4,2">
                        <Grid>
                            <!-- Liste des dimensions (une carte compacte par dimension) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="panel_blocs" Margin="0,0,4,0"/>
                            </ScrollViewer>

                            <!-- Message si aucune dimension -->
                            <TextBlock x:Name="txt_empty" Text="Aucune dimension détectée. Choisissez un DWG."
                                       Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 4. CONTRÔLE & APERÇU -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="4. CONTRÔLE &amp; APERÇU" Style="{StaticResource SectionHeader}"/>
                        <Border Padding="10,8" CornerRadius="8" Background="#DAE3EB" BorderBrush="#C4D1DE" BorderThickness="1">
                            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="txt_preview" Text="Aucun bloc sélectionné."
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Navy}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Statut d'erreur -->
                        <TextBlock x:Name="txt_status" Foreground="{StaticResource Vermillon}" FontWeight="SemiBold"
                                   FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- PIED DE PAGE -->
        <Border Grid.Row="2" Background="#EBEFF2" BorderBrush="#DCE2E7" BorderThickness="0,1,0,0">
            <Grid Margin="14,8,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="lbl_footer_info" Text="©2026 R. Stellia" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btn_cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,8,0" MinWidth="85" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Ico}" Data="M6,6 L18,18 M18,6 L6,18"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Annuler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_create" Style="{StaticResource PrimaryButton}" MinWidth="160" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Ico}" Stroke="White" StrokeThickness="1.8"
                                          Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Implanter les poteaux" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
