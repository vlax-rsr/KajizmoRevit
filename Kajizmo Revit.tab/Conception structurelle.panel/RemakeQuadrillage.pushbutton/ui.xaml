<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kajizmo Revit - Générateur de Quadrillages"
        Width="520"
        Height="680"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#E9EDF0"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- ============ Palette de Couleurs ============ -->
        <SolidColorBrush x:Key="Navy" Color="#17365D"/>
        <SolidColorBrush x:Key="NavyHover" Color="#24508A"/>
        <SolidColorBrush x:Key="NavyPressed" Color="#0F2A4A"/>
        <SolidColorBrush x:Key="Ink" Color="#1B2A3A"/>
        <SolidColorBrush x:Key="Muted" Color="#5E6B78"/>
        <SolidColorBrush x:Key="Tile" Color="#DAE3EB"/>
        <SolidColorBrush x:Key="Line" Color="#D3D9DF"/>
        <SolidColorBrush x:Key="HoverFill" Color="#E6ECF1"/>
        <SolidColorBrush x:Key="Vermillon" Color="#C9372C"/>

        <!-- ============ Icônes (traits 24x24) ============ -->
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Navy}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- ============ TextBox ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Boutons du spinner ============ -->
        <Style x:Key="SpinBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox ============ -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Navy}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,3,0,0"/>
                                    <ScrollViewer Margin="0,6,0,3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Boutons ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Navy}" CornerRadius="6" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Cartes & Blocs ============ -->
        <Style x:Key="SubCard" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E4E8EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#17365D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource Tile}"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== EN-TÊTE (FIXE) ===================== -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DCE7EF" Offset="0"/>
                    <GradientStop Color="#F1F3F1" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackPanel HorizontalAlignment="Center" Margin="16,14,16,12">
                <TextBlock Text="Générateur de quadrillages" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Navy}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lbl_header_subtitle"
                           Text="Étendue sur tous les niveaux"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Pastille niveau -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                    Background="#4F6D8C" CornerRadius="5" Padding="10,4">
                <TextBlock x:Name="lbl_level_badge" Text="Niveau 0" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
            </Border>
        </Grid>

        <!-- ===================== ZONE PRINCIPALE DÉROULANTE (SCROLLVIEWER) ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F1F3F1">
            <Border Margin="16,12,16,12" Padding="14" CornerRadius="10" Background="#EBFFFFFF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#17365D"/>
                </Border.Effect>
                <StackPanel>
                    
                    <!-- ÉTAPE 1 : CADRE & PARAMÈTRES GÉNÉRAUX -->
                    <TextBlock Text="1. CADRE &amp; PARAMÈTRES GÉNÉRAUX" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SubCard}">
                        <StackPanel>
                            <!-- Unité et Débordement -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Unité de travail" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cb_unit" SelectedIndex="0">
                                        <ComboBoxItem Content="Mètres (m)"/>
                                        <ComboBoxItem Content="Millimètres (mm)"/>
                                        <ComboBoxItem Content="Centimètres (cm)"/>
                                    </ComboBox>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Fill="{StaticResource Line}"/>

                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock x:Name="lbl_offset" Text="Débordement (m)" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                                    <Border Height="30" CornerRadius="6" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txt_offset" Grid.Column="0" Text="1.0" Style="{StaticResource BareTextBox}" Padding="8,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <RepeatButton x:Name="btn_off_up" Style="{StaticResource SpinBtn}" Height="12">
                                                    <Path Data="M0,4 L4,0 L8,4" Stroke="{StaticResource Navy}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </RepeatButton>
                                                <RepeatButton x:Name="btn_off_down" Style="{StaticResource SpinBtn}" Height="12">
                                                    <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Navy}" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </RepeatButton>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Type de grille et Couleur -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Type de grille (GridType)" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cb_grid_type"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Style / Couleur" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cb_color" SelectedIndex="1">
                                        <ComboBoxItem Content="Rouge (texte &amp; lignes)"/>
                                        <ComboBoxItem Content="Noir (inversion auto)"/>
                                        <ComboBoxItem Content="Conserver l'actuelle"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ÉTAPE 2 : DÉFINITION DES ENTRAXES -->
                    <TextBlock Text="2. DÉFINITION DES ENTRAXES" Style="{StaticResource SectionHeader}" Margin="2,6,0,6"/>
                    
                    <!-- Axes verticaux (X) -->
                    <Border Style="{StaticResource SubCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,10,0">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource Ico}" Data="M5,4 V20 M12,4 V20 M19,4 V20"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Axes verticaux (X)" Style="{StaticResource CardTitle}"/>
                                <TextBlock Grid.Column="2" Text="Notation :" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="txt_start_x" Grid.Column="3" Width="84" Height="28" SelectedIndex="0">
                                    <ComboBoxItem Content="1, 2, 3..."/>
                                    <ComboBoxItem Content="A, B, C..."/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Distances successives (ex: 3, 4, 5, 5) :" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                            <TextBox x:Name="txt_dist_x" Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- Axes horizontaux (Y) -->
                    <Border Style="{StaticResource SubCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,10,0">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource Ico}" Data="M4,5 H20 M4,12 H20 M4,19 H20"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Axes horizontaux (Y)" Style="{StaticResource CardTitle}"/>
                                <TextBlock Grid.Column="2" Text="Notation :" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="txt_start_y" Grid.Column="3" Width="84" Height="28" SelectedIndex="1">
                                    <ComboBoxItem Content="1, 2, 3..."/>
                                    <ComboBoxItem Content="A, B, C..."/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Distances successives (ex: 3, 4, 5, 5) :" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                            <TextBox x:Name="txt_dist_y" Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- ÉTAPE 3 : APERÇU EN TEMPS RÉEL (LIVE PREVIEW) -->
                    <TextBlock Text="3. CONTRÔLE &amp; APERÇU" Style="{StaticResource SectionHeader}" Margin="2,6,0,6"/>
                    <Border Padding="10,8" CornerRadius="8" Background="#E4EAF0" BorderBrush="#D1DCF0" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Fill="{StaticResource Navy}"/>
                                        <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,11 V17"/>
                                        <Path Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,7.5 L12,7.51"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" x:Name="txt_preview_dims" Text="Emprise : 17.00 m × 17.00 m (5 × 5 files)"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Zone de statut avec TextWrapping pour éviter les débordements -->
                    <TextBlock x:Name="txt_status" Foreground="{StaticResource Vermillon}" FontWeight="SemiBold"
                               FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ===================== PIED DE PAGE (FIXE) ===================== -->
        <Border Grid.Row="2" Background="#EBEFF2" BorderBrush="#DCE2E7" BorderThickness="0,1,0,0">
            <StackPanel>
                <Grid Margin="16,10,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Cliquez sur Créer pour placer les points dans Revit" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btn_cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,8,0" MinWidth="90">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Ico}" Data="M6,6 L18,18 M18,6 L6,18"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Annuler"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btn_create" Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Ico}" Stroke="White" StrokeThickness="1.8"
                                              Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Créer le quadrillage"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="©2026 R. Stellia" FontSize="10" Foreground="#8A95A0"
                           HorizontalAlignment="Right" Margin="0,0,16,4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>