<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créateur de Quadrillages Revit"
        Width="940"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#E9EDF0"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- ============ Palette Le Corbusier (polychromie architecturale) ============ -->
        <SolidColorBrush x:Key="Navy" Color="#17365D"/>
        <SolidColorBrush x:Key="NavyHover" Color="#24508A"/>
        <SolidColorBrush x:Key="NavyPressed" Color="#0F2A4A"/>
        <SolidColorBrush x:Key="Ink" Color="#1B2A3A"/>
        <SolidColorBrush x:Key="Muted" Color="#5E6B78"/>
        <SolidColorBrush x:Key="Tile" Color="#DAE3EB"/>
        <SolidColorBrush x:Key="Line" Color="#D3D9DF"/>
        <SolidColorBrush x:Key="HoverFill" Color="#E6ECF1"/>
        <SolidColorBrush x:Key="Ochre" Color="#E8A71E"/>
        <SolidColorBrush x:Key="Vermillon" Color="#C9372C"/>
        <SolidColorBrush x:Key="Sky" Color="#9DBBD6"/>

        <!-- ============ Icônes (traits 24x24) ============ -->
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Navy}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- ============ TextBox ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Boutons du spinner ============ -->
        <Style x:Key="SpinBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox ============ -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Navy}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,3,0,0"/>
                                    <ScrollViewer Margin="0,6,0,3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Boutons ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Navy}" CornerRadius="6" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tile}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Cartes ============ -->
        <Style x:Key="SubCard" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E4E8EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#17365D"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource Tile}"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== ZONE PRINCIPALE ===================== -->
        <Grid Grid.Row="0" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DCE7EF" Offset="0"/>
                    <GradientStop Color="#F1F3F1" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Façade gauche : béton, ciel, poteau, panneau jaune -->
            <Canvas ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="170" Height="420">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#DAD7D0" Offset="0"/>
                            <GradientStop Color="#C9C5BC" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Canvas.Left="104" Canvas.Top="0" Width="66" Height="62" Fill="#A9C5DD"/>
                <Rectangle Canvas.Left="0" Canvas.Top="14" Width="58" Height="48" Fill="#2C3136"/>
                <Rectangle Canvas.Left="0" Canvas.Top="62" Width="170" Height="9" Fill="#BDB9B0"/>
                <Rectangle Canvas.Left="14" Canvas.Top="71" Width="16" Height="360">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#B6B1A7" Offset="0"/>
                            <GradientStop Color="#F3F1EC" Offset="0.5"/>
                            <GradientStop Color="#B0ABA1" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Canvas.Left="36" Canvas.Top="104" Width="30" Height="200" Fill="{StaticResource Ochre}"/>
                <Rectangle Canvas.Left="0" Canvas.Top="318" Width="70" Height="10" Fill="#B9B5AC"/>
            </Canvas>

            <!-- Façade droite -->
            <Canvas HorizontalAlignment="Right" Width="70" ClipToBounds="True" IsHitTestVisible="False">
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="70" Height="110">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D5E2EC" Offset="0"/>
                            <GradientStop Color="#EEF2F4" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Canvas.Left="34" Canvas.Top="44" Width="36" Height="380" Fill="#D6D2CA"/>
                <Rectangle Canvas.Left="34" Canvas.Top="44" Width="4" Height="380" Fill="#8E8B84"/>
                <Rectangle Canvas.Left="34" Canvas.Top="96" Width="36" Height="8" Fill="#BDB9B0"/>
                <Rectangle Canvas.Left="46" Canvas.Top="118" Width="24" Height="30" Fill="{StaticResource Sky}"/>
            </Canvas>

            <StackPanel>
                <!-- En-tête : logo + titre + sous-titre -->
                <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Canvas Width="40" Height="34" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Rectangle Canvas.Left="2" Canvas.Top="7" Width="36" Height="4" Fill="{StaticResource Navy}"/>
                        <Rectangle Canvas.Left="2" Canvas.Top="21" Width="36" Height="4" Fill="{StaticResource Navy}"/>
                        <Rectangle Canvas.Left="6" Canvas.Top="0" Width="4" Height="34" Fill="{StaticResource Navy}"/>
                        <Rectangle Canvas.Left="18" Canvas.Top="0" Width="4" Height="34" Fill="{StaticResource Navy}"/>
                        <Rectangle Canvas.Left="24" Canvas.Top="12" Width="14" Height="20" Fill="{StaticResource Ochre}"/>
                        <Rectangle Canvas.Left="26" Canvas.Top="0" Width="12" Height="6" Fill="{StaticResource Sky}"/>
                        <Rectangle Canvas.Left="28" Canvas.Top="16" Width="6" Height="6" Fill="{StaticResource Vermillon}"/>
                    </Canvas>
                    <TextBlock Text="Générateur de Quadrillages Revit" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Navy}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lbl_header_subtitle"
                               Text="RÉSEAU SUR NIVEAU 0 — ÉTENDUE TOUS NIVEAUX &amp; 3D"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Carte principale -->
                <Border Margin="70,12,70,16" Padding="14" CornerRadius="10" Background="#EBFFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#17365D"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Axes verticaux (X) -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SubCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,10,0">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource Ico}" Data="M5,4 V20 M12,4 V20 M19,4 V20"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Axes Verticaux (X)" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Grid.Column="2" Text="Départ :" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border Grid.Column="3" Width="84" Height="28" CornerRadius="6" Background="White"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txt_start_x" Grid.Column="0" Text="1"
                                                         Style="{StaticResource BareTextBox}" HorizontalContentAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <RepeatButton x:Name="btn_x_up" Style="{StaticResource SpinBtn}" Height="12">
                                                        <Path Data="M0,4 L4,0 L8,4" Stroke="{StaticResource Navy}" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                    </RepeatButton>
                                                    <RepeatButton x:Name="btn_x_down" Style="{StaticResource SpinBtn}" Height="12">
                                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Navy}" StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Distances entre files (ex: 3, 5, 4, 4) :" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="txt_dist_x" Text="3, 5, 4, 4"/>
                                </StackPanel>
                            </Border>

                            <!-- Axes horizontaux (Y) -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SubCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,10,0">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource Ico}" Data="M4,5 H20 M4,12 H20 M4,19 H20"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Axes Horizontaux (Y)" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Grid.Column="2" Text="Départ :" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="txt_start_y" Grid.Column="3" Width="84" Height="28" SelectedIndex="0">
                                            <ComboBoxItem Content="A"/><ComboBoxItem Content="B"/><ComboBoxItem Content="C"/>
                                            <ComboBoxItem Content="D"/><ComboBoxItem Content="E"/><ComboBoxItem Content="F"/>
                                            <ComboBoxItem Content="G"/><ComboBoxItem Content="H"/><ComboBoxItem Content="I"/>
                                            <ComboBoxItem Content="J"/><ComboBoxItem Content="K"/><ComboBoxItem Content="L"/>
                                            <ComboBoxItem Content="M"/><ComboBoxItem Content="N"/><ComboBoxItem Content="O"/>
                                            <ComboBoxItem Content="P"/><ComboBoxItem Content="Q"/><ComboBoxItem Content="R"/>
                                            <ComboBoxItem Content="S"/><ComboBoxItem Content="T"/><ComboBoxItem Content="U"/>
                                            <ComboBoxItem Content="V"/><ComboBoxItem Content="W"/><ComboBoxItem Content="X"/>
                                            <ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="Distances entre files (ex: 4, 5, 5, 4) :" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="txt_dist_y" Text="4, 5, 5, 4"/>
                                </StackPanel>
                            </Border>

                            <!-- Type de quadrillage + Couleur -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SubCard}">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,10,0">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource Ico}" StrokeThickness="1.6"
                                                          Data="M4,4 H20 V20 H4 Z M10,4 V20 M15,4 V20 M4,10 H20 M4,15 H20"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Type Grid" Style="{StaticResource CardTitle}"/>
                                        <ComboBox Grid.Column="2" x:Name="cb_grid_type"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,10,0">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="24" Height="24">
                                                    <Path Style="{StaticResource Ico}" StrokeThickness="1.7"
                                                          Data="M12,3 C7,3 3,7 3,12 C3,17 7,21 12,21 C13.6,21 14.4,19.8 13.6,18.4 C12.8,17 13.6,15.5 15.3,15.5 H17.5 C19.4,15.5 21,14 21,12 C21,7 17,3 12,3 Z"/>
                                                    <Path Style="{StaticResource Ico}" StrokeThickness="2.4"
                                                          Data="M7.5,11 L7.5,11.01 M10,7.5 L10,7.51 M14.5,7.5 L14.5,7.51 M17,11 L17,11.01"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Couleur" Style="{StaticResource CardTitle}"/>
                                        <ComboBox Grid.Column="2" x:Name="cb_color" SelectedIndex="1">
                                            <ComboBoxItem Content="Rouge (texte &amp; lignes rouges)"/>
                                            <ComboBoxItem Content="Noir (inversion auto)"/>
                                            <ComboBoxItem Content="Conserver couleur actuelle"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Unité + Débordement + Emprise -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SubCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource Ico}" StrokeThickness="1.7"
                                                              Data="M3.5,15.5 L15.5,3.5 L20.5,8.5 L8.5,20.5 Z M7,12 L9.5,14.5 M10,9 L12.5,11.5 M13,6 L15.5,8.5"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="Unité" Style="{StaticResource CardTitle}" FontSize="12"/>
                                            </StackPanel>
                                            <ComboBox x:Name="cb_unit" SelectedIndex="0">
                                                <ComboBoxItem Content="Mètres (m)"/>
                                                <ComboBoxItem Content="Millimètres (mm)"/>
                                                <ComboBoxItem Content="Centimètres (cm)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <Rectangle Grid.Column="1" Fill="{StaticResource Line}"/>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Style="{StaticResource Ico}" StrokeThickness="1.7"
                                                              Data="M3,5 V19 M21,5 V19 M7,12 H17 M7,12 L10,9 M7,12 L10,15 M17,12 L14,9 M17,12 L14,15"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock x:Name="lbl_offset" Text="Débordement (m)" Style="{StaticResource CardTitle}" FontSize="12"/>
                                            </StackPanel>
                                            <Border Height="30" CornerRadius="6" Background="White"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="txt_offset" Grid.Column="0" Text="1.0"
                                                             Style="{StaticResource BareTextBox}" Padding="10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                        <RepeatButton x:Name="btn_off_up" Style="{StaticResource SpinBtn}" Height="12">
                                                            <Path Data="M0,4 L4,0 L8,4" Stroke="{StaticResource Navy}" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </RepeatButton>
                                                        <RepeatButton x:Name="btn_off_down" Style="{StaticResource SpinBtn}" Height="12">
                                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Navy}" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </RepeatButton>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bandeau emprise -->
                                    <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="#E4EAF0">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Fill="{StaticResource Navy}"/>
                                                    <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,11 V17"/>
                                                    <Path Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,7.5 L12,7.51"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="txt_preview_dims" Text="Emprise : 16.00 m × 18.00 m (5 × 5 files)"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="txt_status" Foreground="{StaticResource Vermillon}" FontWeight="SemiBold"
                                   FontSize="11" Margin="2,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Pastille niveau -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
                    Background="#4F6D8C" CornerRadius="5" Padding="12,5">
                <TextBlock x:Name="lbl_level_badge" Text="Niveau 0" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
            </Border>
        </Grid>

        <!-- ===================== PIED DE PAGE ===================== -->
        <Border Grid.Row="1" Background="#EBEFF2" BorderBrush="#DCE2E7" BorderThickness="0,1,0,0">
            <StackPanel>
                <Grid Margin="22,10,22,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{StaticResource Ochre}" Data="M13,2 L5,13.5 H11 L10,22 L19,10 H13 Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Appuyez sur Entrée pour valider" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btn_cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,10,0" MinWidth="104">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Ico}" Data="M6,6 L18,18 M18,6 L6,18"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Annuler"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btn_create" IsDefault="True" Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Ico}" Stroke="White" StrokeThickness="1.8"
                                              Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Créer les Quadrillages [Entrée]"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="©2026 R. Stellia" FontSize="10" Foreground="#8A95A0"
                           HorizontalAlignment="Right" Margin="0,2,22,6"/>

                <!-- Liseré polychrome Le Corbusier -->
                <Grid Height="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{StaticResource Navy}"/>
                    <Rectangle Grid.Column="1" Fill="{StaticResource Ochre}"/>
                    <Rectangle Grid.Column="2" Fill="{StaticResource Vermillon}"/>
                    <Rectangle Grid.Column="3" Fill="{StaticResource Sky}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
